# ============================================================
#  Raízes e Rotas — Monsenhor Hipólito, Piauí
#  .env.example — Modelo de Variáveis de Ambiente e Credenciais
#  Copie este arquivo como .env e preencha com seus valores reais
# ============================================================

# --- Servidor Web e Rede Docker ---
NGINX_HOST=localhost
NGINX_PORT=80
DOCKER_PORT=8080
NODE_ENV=production

# --- Coordenadas Georreferenciadas Oficiais ---
GOOGLE_MAPS_CENTER_LAT=-6.9928
GOOGLE_MAPS_CENTER_LNG=-41.0260
GOOGLE_MAPS_ZOOM=14
GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_KEY

# --- Sistema HASHING e Integridade Criptográfica (SHA-256) ---
SECURITY_HASH_SALT=DEFINE_YOUR_OWN_SECURE_SALT_HERE
SESSION_SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET_FOR_SESSION

# --- Credenciais Administrativas com HASHING ---
ADMIN_USERNAME=gestor_cetijab
# Gere o hash SHA-256 da senha combinada com o SALT
ADMIN_PASSWORD_HASH=HASH_SHA256_DA_SUA_SENHA_ADMIN

# --- Identidade do Projeto ---
APP_NAME=Raízes e Rotas
APP_SUBTITLE=Monsenhor Hipólito Piauí
APP_ESCOLA=Centro Estadual de Tempo Integral José Alves Bezerra (CETIJAB)
APP_COORDENACAO=Prof.ª Jordana Yrla
APP_CITY=Monsenhor Hipólito
APP_STATE=Piauí
APP_IBGE_CODE=2206403
APP_VERSION=3.0.0

# --- Contato Oficial ---
CONTACT_EMAIL=contato.cetijab@seduc.pi.gov.br
CONTACT_PHONE=+55 89 3444-1234
CONTACT_ADDRESS=Rua Manoel Bezerra, Centro, Monsenhor Hipólito - PI, CEP 64650-000

# --- Redes Sociais ---
SOCIAL_INSTAGRAM=https://www.instagram.com/
SOCIAL_FACEBOOK=https://www.facebook.com/
SOCIAL_YOUTUBE=https://www.youtube.com/
